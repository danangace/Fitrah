{
  "name": "fitrah",
  "version": "0.0.0",
  "private": true,
  "description": "Fitrah: Finance Iteration Tools, Review & Agent Hub. A personal agent orchestrator for doc-driven development.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev:runtime": "FITRAH_DEV=1 tsx watch src/main/index.ts",
    "dev:ui": "vite --config vite.web.config.ts",
    "build:ui": "vite build --config vite.web.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "fitrah": "tsx src/cli/fitrah.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "@hono/node-server": "^2.1.6",
    "clsx": "^2.1.1",
    "hono": "^4.13.17",
    "lucide-react": "^1.71.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "ws": "8.22.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "bin": {
    "fitrah": "./bin/fitrah.mjs"
  }
}
